<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageVersion>1.1</PackageVersion>
    <PackageId>NiceShell.Cli.Templates</PackageId>
    <Title>NiceShell Template</Title>
    <Authors>Astor</Authors>
    <Description>NiceShell CLI Templates</Description>
    <PackageTags>dotnet-new;templates</PackageTags>
    <TargetFramework>net10.0</TargetFramework>

    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="template\**" Exclude="template\**\bin\**;template\**\obj\**" />
    <Content Include="play-template\**" Exclude="play-template\**\bin\**;play-template\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>